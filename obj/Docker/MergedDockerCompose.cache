name: dockercompose10125962497776542290
services:
  loganalyser-api:
    build:
      context: C:\Users\stephen.omondi\source\repos\Mo626LogAnalyser
      dockerfile: Mo626LogAnalyser.Server/Dockerfile
    container_name: loganalyser-api
    depends_on:
      loganalyser-client:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ELK__ServerUrl: http://elasticsearch:9200
    networks:
      app-network: null
      mo626_ice_elk: null
    ports:
      - mode: ingress
        target: 8080
        published: "44368"
        protocol: tcp
    restart: unless-stopped
    volumes:
      - type: bind
        source: C:\Users\stephen.omondi\source\repos\Mo626LogAnalyser\Mo626LogAnalyser.Server
        target: /src/Mo626LogAnalyser.Server
        bind:
          create_host_path: true
  loganalyser-client:
    build:
      context: C:\Users\stephen.omondi\source\repos\Mo626LogAnalyser
      dockerfile: Mo626LogAnalyser.Client/Dockerfile
    command:
      - npm
      - run
      - dev
    container_name: loganalyser-client
    environment:
      CHOKIDAR_USEPOLLING: "true"
      NODE_ENV: development
      REACT_APP_API_URL: http://loganalyser-api:8080
      REACT_APP_ENVIRONMENT: Development
    networks:
      app-network: null
    ports:
      - mode: ingress
        target: 5173
        published: "8081"
        protocol: tcp
    restart: unless-stopped
    stdin_open: true
    tty: true
    volumes:
      - type: bind
        source: C:\Users\stephen.omondi\source\repos\Mo626LogAnalyser\mo626loganalyser.client
        target: /app
        bind:
          create_host_path: true
      - type: volume
        target: /app/node_modules
        volume: {}
    working_dir: /app
networks:
  app-network:
    name: dockercompose10125962497776542290_app-network
    driver: bridge
  mo626_ice_elk:
    name: mo626_ice_elk
    external: true