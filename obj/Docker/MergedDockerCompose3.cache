name: dockercompose10125962497776542290
services:
  loganalyser-api:
    build:
      context: C:\Users\stephen.omondi\source\repos\Mo626LogAnalyser
      dockerfile: Mo626LogAnalyser.Server/Dockerfile
      args:
        BUILD_CONFIGURATION: Debug
        LAUNCHING_FROM_VS: "true"
      labels:
        com.microsoft.created-by: visual-studio
        com.microsoft.visual-studio.project-name: Mo626LogAnalyser.Server
      target: base
    container_name: loganalyser-api
    entrypoint:
      - dotnet
      - --roll-forward
      - Major
      - /VSTools/DistrolessHelper/DistrolessHelper.dll
      - --wait
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_LOGGING__CONSOLE__DISABLECOLORS: "true"
      DOTNET_USE_POLLING_FILE_WATCHER: "1"
      ELK__ServerUrl: http://elasticsearch:9200
      NUGET_FALLBACK_PACKAGES: /.nuget/fallbackpackages
    image: loganalyserapi:dev
    labels:
      com.microsoft.visualstudio.debuggee.arguments: ' --additionalProbingPath /.nuget/packages --additionalProbingPath /.nuget/fallbackpackages  "/app/bin/Debug/net8.0/Mo626LogAnalyser.Server.dll"'
      com.microsoft.visualstudio.debuggee.killprogram: dotnet --roll-forward Major /VSTools/DistrolessHelper/DistrolessHelper.dll --stop dotnet
      com.microsoft.visualstudio.debuggee.program: dotnet
      com.microsoft.visualstudio.debuggee.workingdirectory: /app
    networks:
      app-network: null
      mo626_ice_elk: null
    ports:
      - mode: ingress
        target: 8080
        published: "44368"
        protocol: tcp
    restart: unless-stopped
    tty: true
    volumes:
      - type: bind
        source: C:\Users\stephen.omondi\source\repos\Mo626LogAnalyser\Mo626LogAnalyser.Server
        target: /src/Mo626LogAnalyser.Server
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\stephen.omondi\source\repos\Mo626LogAnalyser\Mo626LogAnalyser.Server
        target: /app
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\stephen.omondi\source\repos\Mo626LogAnalyser
        target: /src
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\stephen.omondi\vsdbg\vs2017u5
        target: /remote_debugger
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\stephen.omondi\.nuget\packages
        target: /.nuget/packages
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages
        target: /.nuget/fallbackpackages
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\stephen.omondi\AppData\Roaming\ASP.NET\Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\stephen.omondi\AppData\Roaming\ASP.NET\Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\stephen.omondi\AppData\Roaming\Microsoft\UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\stephen.omondi\AppData\Roaming\Microsoft\UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Sdks\Microsoft.Docker.Sdk\tools\linux-x64\net8.0
        target: /VSTools
